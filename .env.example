# MongoDB connection string. Atlas (mongodb+srv://...) or local (mongodb://localhost:27017/bullet-in).
MONGODB_URI=mongodb://localhost:27017

# Database name. Overrides any database named in MONGODB_URI. Defaults to bullet-in.
MONGODB_DB_NAME=bullet-in

# Signs the login cookie. At least 32 characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Production (NODE_ENV=production): the port that serves the whole app.
PORT=3000

# Development: the API's port. Vite serves the app on 5180 and forwards /api here.
API_PORT=3000

# Only the first account can register unless this is true.
ALLOW_REGISTRATION=false

# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik) that terminates HTTPS.
TRUST_PROXY=false
