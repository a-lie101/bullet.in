{
  "name": "bullet.in",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted personal kanban board that pulls in your GitHub issues and AI-suggested action items.",
  "main": "dist/index.js",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false src/index.ts",
    "dev:web": "npm run dev -w web",
    "build": "tsc -p tsconfig.json && npm run build -w web",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run build -w web",
    "test": "vitest run",
    "db:dev": "tsx scripts/dev-db.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-lie101/bullet.in.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/a-lie101/bullet.in/issues"
  },
  "homepage": "https://github.com/a-lie101/bullet.in#readme",
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongodb": "~7.8",
    "mongoose": "^9.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "mongodb-memory-server-core": "^11.3.0",
    "supertest": "^7.3.2",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
